---
import landing from "../../data/landing.json";
// Imported, not in public/: the build hashes them into /_astro/, which Vercel serves as immutable.
import video from "../../assets/demo/junction-demo.mp4?url";
import poster from "../../assets/demo/junction-demo.jpg?url";
import captions from "../../assets/demo/junction-demo.en.vtt?url";
const { demo } = landing;
---

<section class="sec demo" id="demo" data-reveal>
  <span class="eyebrow">{demo.eyebrow}</span>
  <h2 set:html={demo.heading} />
  <p class="lead">{demo.lead}</p>
  <div class="demo-frame">
    <video controls playsinline preload="none" poster={poster} width="1920" height="1080" aria-label={demo.label}>
      <source src={video} type="video/mp4" />
      <track kind="captions" src={captions} srclang="en" label="English" />
    </video>
  </div>
  <p class="demo-credit" set:html={demo.credit} />
</section>
